# Skopiuj do .env.local (plik nie trafia do repozytorium)

# Adres API używany przez front-end. Ścieżka względna: żądania trafiają do nginx,
# który przekazuje je do back-endu. Dzięki temu w kodzie nie ma żadnego URL.
VITE_API_URL=/api

# Tylko dla `npm run dev`: dokąd Vite ma przekazywać /api (puste = bez proxy)
DEV_PROXY_TARGET=

# Tylko dla kontenera nginx (zmienna uruchomieniowa, nie Vite): adres back-endu
BACKEND_URL=
