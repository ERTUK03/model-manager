# Plik jest szablonem: obraz nginx podstawia zmienne środowiskowe (np. BACKEND_URL)
# przy starcie kontenera i zapisuje wynik jako /etc/nginx/conf.d/default.conf
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Zapytania do API trafiają do back-endu (prywatna podsieć)
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Aplikacja SPA: nieznane ścieżki wracają do index.html
    location / {
        try_files $uri /index.html;
    }
}
