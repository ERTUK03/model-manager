# Plik jest szablonem: obraz nginx podstawia zmienne środowiskowe (np. BACKEND_URL)
# przy starcie kontenera i zapisuje wynik jako /etc/nginx/conf.d/default.conf
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Sonda stanu kontenera (nie dotyka back-endu)
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Wersja wdrożonego front-endu: zawsze świeża, bez pamięci podręcznej (sprawdza ją healthcheck po wdrożeniu)
    location = /version.json {
        add_header Cache-Control "no-store";
    }

    # Po nowym wdrożeniu przeglądarka ma od razu pobrać nową wersję aplikacji
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # Pliki z hashem w nazwie nigdy się nie zmieniają, więc można je trzymać w pamięci podręcznej bardzo długo
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Zapytania do API trafiają do back-endu (prywatna podsieć)
    location /api/ {
        # Przesyłanie plików modeli. Limit musi być nie mniejszy niż MAX_UPLOAD_MB back-endu
        client_max_body_size 250m;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Aplikacja SPA: nieznane ścieżki wracają do index.html
    location / {
        try_files $uri /index.html;
    }
}
