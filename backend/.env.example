# Skopiuj do .env (plik jest w .gitignore i nie trafia do repozytorium).
# Wartości poniżej to tylko wzory. Hasła ustaw własne.

APP_ENV=development

# Dozwolone źródła dla CORS, oddzielone przecinkami. Zostaw puste, jeśli ruch idzie przez nginx.
CORS_ORIGINS=

# Connection string do bazy. WYMAGANY: bez niego aplikacja się nie uruchomi.
# Lokalnie (baza z docker-compose.dev.yml), użyj tych samych danych co poniżej:
#   DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DBNAME
# Azure PostgreSQL: adres serwera z portalu i na końcu ?sslmode=require
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DBNAME

# Tylko dla docker-compose.dev.yml (lokalna baza). Muszą zgadzać się z DATABASE_URL.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Pierwszy administrator: używane tylko przez `python -m scripts.create_admin`.
# Hasło: min. 8 znaków, w tym litera i cyfra.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Magazyn plików modeli.
# Lokalnie (emulator Azurite z docker-compose.dev.yml): UseDevelopmentStorage=true
# W Azure zostaw puste i ustaw STORAGE_ACCOUNT_URL (np. https://NAZWA.blob.core.windows.net):
# aplikacja używa wtedy tożsamości zarządzanej, bez żadnych kluczy.
STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
STORAGE_ACCOUNT_URL=
STORAGE_CONTAINER=models
# Maksymalny rozmiar pliku modelu w MB oraz czas ważności adresu pobierania w sekundach
MAX_UPLOAD_MB=200
DOWNLOAD_URL_EXPIRE_SECONDS=300
